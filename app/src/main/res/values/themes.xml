<resources>
    <!--
      Launch theme. androidx.core.splashscreen swaps to postSplashScreenTheme
      once the first frame is ready, so no manual delay is needed.
    -->
    <style name="Theme.Tenky" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/celadon_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Tenky.Main</item>
    </style>

    <!-- Colours come from the Compose theme; this only styles the window. -->
    <style name="Theme.Tenky.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/azure_x_web_color</item>
    </style>
</resources>
