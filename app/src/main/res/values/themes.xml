<resources>
    <!--
      Launch theme. androidx.core.splashscreen swaps to postSplashScreenTheme
      once the first frame is ready, so no manual delay is needed.
    -->
    <style name="Theme.Tenky" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">1200</item>
        <item name="postSplashScreenTheme">@style/Theme.Tenky.Main</item>
    </style>

    <!--
      Descends from AppCompat because MainActivity is an AppCompatActivity,
      which is what backports the per-app language below Android 13. Colours
      come from the Compose theme; this only styles the window.
    -->
    <style name="Theme.Tenky.Main" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
